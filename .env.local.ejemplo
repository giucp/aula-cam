# Copiá este archivo como  .env.local  y completá los valores.
# .env.local NUNCA se commitea (está en .gitignore). Este .ejemplo SÍ (sin valores).

# Cuentas Moodle de lectura para la fábrica de contenido curado.
# A = cuenta del grado que se cura como "5to grado"; B = como "1er año".
MOODLE_USER_A=
MOODLE_PASS_A=
MOODLE_USER_B=
MOODLE_PASS_B=

# Supabase (las mismas que ya usa el proyecto en Vercel).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── IA ──
# Proveedor activo. Por defecto "deepseek". Poner "gemini" para volver al anterior
# (todo su código sigue en api/generar.js, intacto y apagado).
IA_PROVEEDOR=deepseek
# Key de DeepSeek. En Vercel va como variable de entorno del proyecto aula-cam.
# ★ Si esta falta, la app NO se rompe: vuelve sola a Gemini (ver api/generar.js).
DEEPSEEK_API_KEY=
# Opcionales, solo si hace falta cambiarlos:
#   DEEPSEEK_MODEL          (por defecto deepseek-flash)
#   DEEPSEEK_MAX_TOKENS     (por defecto 8000 — NO bajarlo: el modelo razona y con poco
#                            presupuesto la respuesta vuelve vacía)
